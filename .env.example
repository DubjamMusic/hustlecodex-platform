# =========================================================================
# HustleCodeX Platform - Environment Variables
# =========================================================================
# Copy this file to .env.local and fill in your values
# See lib/env.ts for Zod validation schema
# =========================================================================

# -----------------
# Public Variables (exposed to browser)
# -----------------
NEXT_PUBLIC_SITE_URL=https://www.recoveryrpg.co.uk
NEXT_PUBLIC_SITE_NAME="HustleCodeX - Reality Recovery Platform"

# -----------------
# AI Provider Keys (Server-side only)
# -----------------
# OpenAI API key for GPT-4/3.5-turbo agent calls
# Get yours at: https://platform.openai.com/api-keys
# Used by: agents/affirmAgent.ts, agents/challengeAgent.ts
OPENAI_API_KEY=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

# Anthropic API key for Claude Opus/Sonnet (optional)
# Get yours at: https://console.anthropic.com/
# Uncomment to enable Claude-powered agents
 ANTHROPIC_API_KEY=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

# -----------------
# Database Configuration
# -----------------
# PostgreSQL connection string for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# IONOS managed database or any PostgreSQL 12+ instance
# Used by: lib/prisma.ts, all database operations
DATABASE_URL=postgresql://user:password@your-ionos-host.com:5432/hustlecodex?schema=public

# Direct database connection (for Prisma migrations)
# Same as DATABASE_URL but may bypass connection poolers
DIRECT_URL=postgresql://user:password@your-ionos-host.com:5432/hustlecodex?schema=public

# -----------------
# Email/SMTP Configuration
# -----------------
# SMTP credentials for transactional emails (recovery check-ins, notifications)
# Recommended providers: SendGrid, Mailgun, AWS SES
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
SMTP_FROM_EMAIL=noreply@hustlecodex.com
SMTP_FROM_NAME=HustleCodeX Platform

# -----------------
# Feature Flags
# -----------------
# Comma-separated list of enabled features
# Format: feature_name:boolean,another_feature:boolean
# Used by: lib/featureFlags.ts
# Available flags:
#   - decision_loop_enabled: Main decision flow
#   - multi_agent_enabled: Use multiple agents (affirm + challenge)
#   - memory_scoring_enabled: Score and decay memory fragments
#   - telemetry_enabled: Track user analytics
#   - streaming_enabled: Stream agent responses in real-time
FEATURE_FLAGS=decision_loop_enabled:true,multi_agent_enabled:true,memory_scoring_enabled:true,telemetry_enabled:true,streaming_enabled:false

# -----------------
# Vercel Edge Config (Production)
# -----------------
# Vercel Edge Config for feature flags (production)
# Get from: Vercel Dashboard → Project → Storage → Edge Config
# Used by: lib/featureFlags.ts (via @vercel/edge-config)
# Leave empty for local development (uses FEATURE_FLAGS instead)
EDGE_CONFIG=
EDGE_CONFIG_ITEM_KEY=hustlecodex_features

# -----------------
# Analytics & Monitoring
# -----------------
# Vercel Analytics (built-in, no key needed)
# Enable in vercel.json and Vercel Dashboard
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Plausible Analytics (optional, privacy-friendly)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=hustlecodex.com

# Custom analytics write key for telemetry
# Used by: lib/telemetry.ts
# Leave empty to store in database only
ANALYTICS_WRITE_KEY=

# -----------------
# Payment Integration (Future)
# -----------------
# Gumroad for digital products
NEXT_PUBLIC_GUMROAD_ID=your_gumroad_id

# Stripe for subscriptions
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# -----------------
# Legacy Supabase (Nexus Recovery Features)
# -----------------
# Note: The new decision loop uses Prisma + PostgreSQL
# These are kept for backward compatibility with existing Nexus features
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -----------------
# Session & Security
# -----------------
# Secret for signing session tokens (generate with: openssl rand -base64 32)
SESSION_SECRET=your_random_32_character_secret_here

# CORS allowed origins (production domains)
ALLOWED_ORIGINS=https://hustlecodex.com,https://www.hustlecodex.com

# -----------------
# Development Settings
# -----------------
# Set to true to enable detailed logging
DEBUG_MODE=false

# Set to true to use mock AI responses (no API calls)
MOCK_AI_RESPONSES=false

# -----------------
# Monetization Hooks (Placeholders)
# -----------------
# Premium tier identifier for gating features
# Used in: pages/api/decision.ts, lib/memory.ts
PREMIUM_TIER_ID=premium_v1

# Free tier limits
FREE_TIER_DECISION_LIMIT=50
FREE_TIER_MEMORY_LIMIT=100

# =========================================================================
# VALIDATION: Run `npm run validate-env` to check all required vars
# See: lib/env.ts for the Zod validation schema
# =========================================================================
