# Environment Variables Template
# Copy this file to .env.local and fill in your values

# ============================================
# Core Application
# ============================================
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_NAME="HustleCodeX - Reality Recovery Platform"

# ============================================
# Supabase Configuration (NEW)
# ============================================
# Get these from: https://app.supabase.com/project/<your-project>/settings/api

# Public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-only (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# OpenAI Configuration (NEW)
# ============================================
# Server-only (NEVER expose to browser)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Customize AI behavior
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# ============================================
# Feature Flags
# ============================================
NEXT_PUBLIC_ENABLE_NEXUS_RECOVERY=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_PAYMENTS=false
NEXT_PUBLIC_ENABLE_COMMUNITY_MAPPING=false

# ============================================
# Analytics (Optional)
# ============================================
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ============================================
# Payment Integration (Optional)
# ============================================
NEXT_PUBLIC_GUMROAD_ID=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
