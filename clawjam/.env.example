# CLAWJAM SaaS — placeholders only; never commit real values
APP_BASE_URL=https://your-domain.example
NODE_ENV=production

# Existing PostgreSQL / Prisma
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Queue / rate limits
REDIS_URL=redis://HOST:6379

# Authentication
AUTH_SECRET=replace-with-32-byte-random-secret
ENCRYPTION_KEY=replace-with-managed-kms-or-32-byte-key

# Billing (configure only after provider account setup)
BILLING_SECRET_KEY=
BILLING_WEBHOOK_SECRET=
BILLING_PRICE_STARTER=
BILLING_PRICE_PRO=
BILLING_PRICE_STUDIO=

# Telegram
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN= # development-only single bot; production tokens belong in encrypted tenant integration storage

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# OpenClaw connector — use short-lived/revocable connector credentials
CLAWJAM_CONNECTOR_URL=
CLAWJAM_CONNECTOR_TOKEN=

# AI provider routing — server-side only
AI_GATEWAY_API_KEY=
AI_DEFAULT_MODEL=

# Observability
LOG_LEVEL=info
